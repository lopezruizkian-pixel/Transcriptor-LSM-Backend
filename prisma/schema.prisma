generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClassSession {
  id                  String   @id @default(uuid())
  classId             String
  topicContext        String
  fullTranscription   String   @db.Text
  fullLsm             String   @db.Text
  summary             String   @db.Text
  createdAt           DateTime @default(now())
}
